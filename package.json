{
  "name": "ideas-cli",
  "version": "0.1.3",
  "description": "Local-first ideas CLI with markdown storage and AI helpers",
  "author": "Valentin Prugnaud <valentin@whatdafox.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ideas": "./dist/ideas.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/bin/ideas.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "changeset publish"
  },
  "dependencies": {
    "@inquirer/select": "^5.1.2",
    "ai": "^7.0.9",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^17.3.1",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "strip-ansi": "^7.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
